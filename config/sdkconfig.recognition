CONFIG_HB_BOARD_PROFILE_CONFIRMED=y
CONFIG_HB_WIFI_DIAGNOSTICS=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_WIFI_AUTO_CONNECT_ON_STA_START=n
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=20000
CONFIG_HB_IDENTITY_EXPERIMENTAL=y
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_FLASH_PARTITION=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=3
CONFIG_HB_IDENTITY_PERSISTENCE=y
CONFIG_HB_IDENTITY_LOCAL_UNENCRYPTED=y
