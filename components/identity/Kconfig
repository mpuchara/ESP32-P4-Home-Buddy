menu "Home Buddy local identity (experimental)"
config HB_IDENTITY_EXPERIMENTAL
    bool "Enable local onboard Flash MBF recognition worker"
    default n
    help
        Explicit development opt-in. Requires the provisioned human_face_feat
        onboard Flash partition. Never downloads models during operation.
config HB_IDENTITY_PERSISTENCE
    bool "Enable local profile persistence"
    default n
    help
        Uses the existing profiles partition. Never provisions device security.
config HB_IDENTITY_LOCAL_UNENCRYPTED
    bool "Explicit local unencrypted household storage policy"
    depends on HB_IDENTITY_PERSISTENCE
    default n
    help
        Owner selected automatic local storage without encryption or unlock.
        With this off, persistence requires hardware encryption and Secure Boot.
config HB_IDENTITY_THRESHOLD_MILLI
    int "Experimental cosine acceptance threshold (thousandths)"
    range 0 1000
    default 700
config HB_IDENTITY_MARGIN_MILLI
    int "Experimental different-person margin (thousandths)"
    range 1 1000
    default 120
config HB_IDENTITY_AGREEMENT_MILLI
    int "Experimental template agreement floor (thousandths)"
    range 0 1000
    default 600
endmenu
